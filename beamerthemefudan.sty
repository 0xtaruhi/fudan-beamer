% beamerthemefudan.sty -- a restrained Fudan red / Fudan blue Beamer theme for XeLaTeX.
%
% Copyright 2026 Zhengyi Zhang
% Licensed under the Apache License, Version 2.0 (see LICENSE).
% The emblem and background artwork in resources/ derive from
% sonnyhcl/beamerthemefdu (Apache-2.0); see NOTICE.
%
% Usage:  \documentclass[aspectratio=169,10pt]{beamer}
%         \usetheme{fudan}
% Compile with XeLaTeX (latexmk -xelatex).

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemefudan}[2026/10/14 v1.0 Fudan red Beamer theme]

% ------------------------------------------------------------------ options
\newif\iffudan@fonts \fudan@fontstrue
\DeclareOptionBeamer{nofonts}{\fudan@fontsfalse}
\def\fudan@resources{resources/}
\DeclareOptionBeamer{resources}{\def\fudan@resources{#1}}
% color=red|blue selects Fudan red (default) or Fudan blue for accents and the emblem.
\def\fudan@color{red}
\DeclareOptionBeamer{color}{\edef\fudan@color{#1}}
\ProcessOptionsBeamer
\def\fudan@red{red}\def\fudan@blue{blue}
\ifx\fudan@color\fudan@red\else\ifx\fudan@color\fudan@blue\else
  \PackageError{beamerthemefudan}{Unknown color `\fudan@color'}{Use color=red or color=blue.}
\fi\fi
\def\fudan@logo{\fudan@resources fudan-\fudan@color.pdf}

% ------------------------------------------------------------------ fonts
% Latin: Source Serif 4 (headings) / Source Sans 3 (body) / IBM Plex Mono (code)
% CJK:   Noto Serif CJK SC (宋体, headings) / Noto Sans CJK SC (黑体, body)
%        / LXGW WenKai (楷体, subtitles and notes; falls back to FandolKai)
\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\iffudan@fonts
  \setsansfont{SourceSans3}[Extension=.otf, UprightFont=*-Regular, BoldFont=*-Semibold,
    ItalicFont=*-RegularIt, BoldItalicFont=*-SemiboldIt]
  \setmainfont{SourceSerif4}[Extension=.otf, UprightFont=*-Regular, BoldFont=*-Semibold,
    ItalicFont=*-RegularIt, BoldItalicFont=*-SemiboldIt]
  \setmonofont{IBMPlexMono}[Extension=.otf, UprightFont=*-Regular, BoldFont=*-SemiBold, Scale=0.88]
  \setCJKsansfont{Noto Sans CJK SC}[BoldFont={Noto Sans CJK SC Bold}]
  \setCJKmainfont{Noto Serif CJK SC}[BoldFont={Noto Serif CJK SC Bold}]
  \setCJKmonofont{Noto Sans CJK SC}
  \IfFontExistsTF{LXGW WenKai}
    {\setCJKfamilyfont{kai}{LXGW WenKai}}
    {\setCJKfamilyfont{kai}{FandolKai-Regular.otf}}
\else
  \setCJKfamilyfont{kai}{FandolKai-Regular.otf}
\fi
% \kai: serif italic for Latin, Kai for CJK.
\newcommand{\kai}{\rmfamily\itshape\CJKfamily{kai}}
\usefonttheme{professionalfonts}

% ------------------------------------------------------------------ packages
\RequirePackage{booktabs,tabularx,array}
\RequirePackage{colortbl}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{listings}

% ------------------------------------------------------------------ colors
\definecolor{fdred}{HTML}{9E1B32}   % Fudan red
\definecolor{fdblue}{HTML}{0E419C}  % Fudan blue
\ifx\fudan@color\fudan@blue
  \colorlet{accent}{fdblue}         % the only accent colour
\else
  \colorlet{accent}{fdred}
\fi
\definecolor{ink}{HTML}{1A1A1A}     % body text
\definecolor{muted}{HTML}{6F6E69}   % secondary text
\definecolor{rule}{HTML}{E2E0DC}    % hairlines under frame titles
\definecolor{paper}{HTML}{F4F3F1}   % code and box backgrounds

% ------------------------------------------------------------------ base styling
\setbeamertemplate{navigation symbols}{}
\setbeamercolor{normal text}{fg=ink,bg=white}
\setbeamercolor{structure}{fg=accent}
\setbeamercolor{alerted text}{fg=accent}
\setbeamerfont{frametitle}{family=\rmfamily, size=\fontsize{15}{18}, series=\bfseries}
\setbeamertemplate{itemize item}{\color{accent}\raisebox{0.3ex}{\rule{0.42ex}{0.42ex}}}
\setbeamertemplate{itemize subitem}{\color{muted}\textendash}
\setbeamertemplate{enumerate item}{\color{accent}\rmfamily\insertenumlabel.}
\setlength{\leftmargini}{1.1em}
\setbeamersize{text margin left=8mm, text margin right=8mm}

% Emblem watermark on every slide: placement and size of sonnyhcl/beamerthemefdu
% (11 cm wide), at 8% opacity so it stays visible on bright screens.
\setbeamertemplate{background canvas}{%
  \begin{tikzpicture}
    \path (0,0) -- (\paperwidth,\paperheight);
    \node[opacity=.08] at (0.8\paperwidth,0.25\paperheight)
      {\includegraphics[width=11cm]{\fudan@resources background}};
  \end{tikzpicture}}

% Frame title: red section kicker, serif title, optional Kai subtitle, hairline.
\setbeamertemplate{frametitle}{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north east] at ([xshift=-7mm,yshift=-4.2mm]current page.north east)
      {\includegraphics[height=4.6mm]{\fudan@logo}};
  \end{tikzpicture}%
  \vspace*{-0.5mm}%
  {\sffamily\fontsize{6.5}{7}\selectfont\color{accent}\insertsectionhead}\par\vspace{0.2mm}
  {\usebeamerfont{frametitle}\color{ink}\insertframetitle}%
  \ifx\insertframesubtitle\empty\else
    \hspace{3mm}{\kai\small\color{muted}\insertframesubtitle}\fi
  \par\vspace{0.8mm}{\color{rule}\rule{\linewidth}{0.5pt}}\par\vspace{-1.5mm}}

\setbeamertemplate{footline}{%
  \hbox to \paperwidth{\hspace{6mm}{\rmfamily\itshape\tiny\color{muted}\insertshorttitle}\hfill
  {\rmfamily\tiny\color{muted}\insertframenumber}\hspace{6mm}}\vspace{3mm}}

\setbeamertemplate{title page}{%
  \vspace*{-2mm}
  \includegraphics[height=12mm]{\fudan@logo}\par\vspace{14mm}
  {\rmfamily\bfseries\fontsize{25}{30}\selectfont\color{ink}\inserttitle}\par\vspace{4mm}
  {\color{accent}\rule{18mm}{1.2pt}}\par\vspace{4mm}
  {\kai\large\color{muted}\insertsubtitle}\par\vspace{12mm}
  {\small\color{ink}\insertauthor
    \ifx\insertinstitute\empty\else\quad{\color{muted}|}\quad\insertinstitute\fi
    \quad{\color{muted}|}\quad\insertdate}\vfill}

% ------------------------------------------------------------------ commands
% \partslide{kicker}{section title}{one-line description}
% Starts a \section and emits a plain divider slide.
\newcommand{\partslide}[3]{%
  \section{#2}
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      \fill[accent] (current page.north west) rectangle ([xshift=3mm]current page.south west);
      \node[anchor=south west, font=\small, text=accent] at ([xshift=16mm,yshift=4mm]current page.west) {#1};
      \node[anchor=north west, font=\rmfamily\bfseries\fontsize{24}{28}\selectfont, text=ink]
        at ([xshift=16mm,yshift=2mm]current page.west) {#2};
      \draw[accent, line width=1.2pt] ([xshift=16mm,yshift=-10mm]current page.west) -- ++(14mm,0);
      \node[anchor=north west, text width=110mm, font=\kai\normalsize, text=muted]
        at ([xshift=16mm,yshift=-13mm]current page.west) {#3};
      \node[anchor=south east] at ([xshift=-8mm,yshift=8mm]current page.south east)
        {\includegraphics[height=7mm]{\fudan@logo}};
    \end{tikzpicture}
  \end{frame}}

% \key{...}: the one-sentence takeaway placed under a frame title.
\newcommand{\key}[1]{{\color{accent}\rule[-0.35ex]{1.3pt}{1.1em}}\hspace{2.5mm}{\rmfamily\bfseries\large #1}\par\vspace{3mm}}
% \best{...}: a number or phrase that deserves attention.
\newcommand{\best}[1]{\textbf{\color{accent}#1}}
% \pt{lead}{detail}: bold lead word followed by muted detail.
\newcommand{\pt}[2]{\textbf{#1}\enspace{\color{muted}#2}}
% \hd{...}: serif heading inside a slide body.
\newcommand{\hd}[1]{{\rmfamily\bfseries\color{ink}#1}}
% \colhead{...}: muted table column header.
\newcommand{\colhead}[1]{{\color{muted}#1}}
% \src{...}: small Kai note under a table or figure.
\newcommand{\src}[1]{\par\vspace{1.2mm}{\kai\scriptsize\color{muted}#1}}

% ------------------------------------------------------------------ tables
% booktabs rules: all three in black; heavy top/bottom, light middle.
\renewcommand{\arraystretch}{1.18}
\newcolumntype{C}{>{\centering\arraybackslash}X}
\arrayrulecolor{ink}
\setlength{\heavyrulewidth}{1.2pt}
\setlength{\lightrulewidth}{0.6pt}
\setlength{\cmidrulewidth}{0.5pt}

% ------------------------------------------------------------------ blocks and theorems
% Square blocks with a light tint: accent title text on a pale accent band,
% an even paler body; alert blocks are a step stronger, example blocks are neutral.
\def\fudan@blockbegin#1#2{%
  \par\vskip\medskipamount
  \begin{beamercolorbox}[colsep*=.75ex,sep=1.4mm,vmode]{#1}%
    \usebeamerfont*{block title}\insertblocktitle\par
  \end{beamercolorbox}\nointerlineskip
  \begin{beamercolorbox}[colsep*=.75ex,sep=1.6mm,vmode]{#2}%
    \usebeamerfont{block body}\ifbeamercolorempty[bg]{#2}{}{\vskip-.25ex}}
\def\fudan@blockend{\end{beamercolorbox}\vskip\smallskipamount}
\setbeamertemplate{block begin}{\fudan@blockbegin{block title}{block body}}
\setbeamertemplate{block end}{\fudan@blockend}
\setbeamertemplate{block alerted begin}{\fudan@blockbegin{block title alerted}{block body alerted}}
\setbeamertemplate{block alerted end}{\fudan@blockend}
\setbeamertemplate{block example begin}{\fudan@blockbegin{block title example}{block body example}}
\setbeamertemplate{block example end}{\fudan@blockend}
\setbeamercolor{block title}{fg=accent, bg=accent!9!white}
\setbeamercolor{block body}{fg=ink, bg=accent!3!white}
\setbeamercolor{block title alerted}{fg=accent!85!black, bg=accent!16!white}
\setbeamercolor{block body alerted}{fg=ink, bg=accent!6!white}
\setbeamercolor{block title example}{fg=ink, bg=ink!8}
\setbeamercolor{block body example}{fg=ink, bg=ink!3}
\setbeamerfont{block title}{family=\rmfamily, series=\bfseries, size=\small}
\setbeamerfont{block body}{size=\small}
\setbeamertemplate{theorems}[numbered]
\deftranslation{Theorem}{定理}
\deftranslation{Definition}{定义}
\deftranslation{Definitions}{定义}
\deftranslation{Lemma}{引理}
\deftranslation{Corollary}{推论}
\deftranslation{Fact}{事实}
\deftranslation{Example}{例}
\deftranslation{Examples}{例}
\deftranslation{Proof}{证明}
\setbeamertemplate{qed symbol}{\color{accent}\rule{0.6em}{0.6em}}
\AtBeginDocument{\renewcommand{\proofname}{证明}}
% Continued frames (allowframebreaks) keep the plain title.
\setbeamertemplate{frametitle continuation}{}

% ------------------------------------------------------------------ footnotes
\setbeamercolor{footnote mark}{fg=accent}
\setbeamerfont{footnote}{size=\tiny}
\setbeamertemplate{footnote}{%
  \parindent 0em\noindent\raggedright
  \hbox to 1.4em{\hfil{\color{accent}\insertfootnotemark}\enspace}{\color{muted}\insertfootnotetext}\par}

% ------------------------------------------------------------------ bibliography
\setbeamertemplate{bibliography item}[text]
\setbeamercolor{bibliography item}{fg=accent}
\setbeamercolor{bibliography entry author}{fg=ink}
\setbeamercolor{bibliography entry title}{fg=ink}
\setbeamercolor{bibliography entry location}{fg=muted}
\setbeamercolor{bibliography entry note}{fg=muted}
\setbeamerfont{bibliography item}{size=\scriptsize}
\setbeamerfont{bibliography entry author}{size=\scriptsize}
\setbeamerfont{bibliography entry title}{size=\scriptsize}
\setbeamerfont{bibliography entry location}{size=\scriptsize}

% ------------------------------------------------------------------ captions
% "表 1 / 图 1" in bold accent, caption text in serif; numbered per document.
% Put table captions above the table and figure captions below the figure.
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{caption label separator}{}
\setbeamerfont{caption}{size=\small}
\setbeamerfont{caption name}{series=\bfseries}
\setbeamercolor{caption name}{fg=accent}
\setbeamercolor{caption}{fg=ink}
\setbeamertemplate{caption}{%
  \raggedright{\usebeamercolor[fg]{caption name}\usebeamerfont{caption name}%
  \insertcaptionname\,\insertcaptionnumber}\enspace{\rmfamily\insertcaption}\par}
\AtBeginDocument{\renewcommand{\tablename}{表}\renewcommand{\figurename}{图}}
\setlength{\abovecaptionskip}{1.5mm}
\setlength{\belowcaptionskip}{1.5mm}

% ------------------------------------------------------------------ code
\lstset{basicstyle=\ttfamily\scriptsize, columns=fullflexible,
  keywordstyle=\color{accent}, commentstyle=\color{muted}\itshape,
  frame=leftline, rulecolor=\color{accent}, framesep=5pt, xleftmargin=7pt,
  backgroundcolor=\color{paper}, aboveskip=2pt, belowskip=2pt}

\endinput
